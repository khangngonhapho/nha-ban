{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["index.html", "canvas.html", "links.html", "view-images.html", "manifest.json", "sw.js", "static/**", "system_prompt.txt", "api/credentials.json"]
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    { "src": "/avatarKhangNgo.jpg", "dest": "/avatarKhangNgo.jpg" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
